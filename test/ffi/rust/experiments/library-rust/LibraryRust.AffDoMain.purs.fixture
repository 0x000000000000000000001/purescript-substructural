module LibraryRust.AffDoMain where

import Prelude

import Effect (Effect)
import Effect.Aff (launchAff_)
import Effect.Class (liftEffect)
import Effect.Console (log)
import Test.Data.Function.Sub.Aff.Do as AffDo

main :: Effect Unit
main = launchAff_ do
  AffDo.spec
  liftEffect (log "SUBSTRUCTURAL_AFF_DO_RUST_OK")
